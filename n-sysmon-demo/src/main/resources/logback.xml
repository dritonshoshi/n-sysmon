<?xml version="1.0" encoding="UTF-8"?>
<!--
  Replaces the former log4j.properties. Console appender with the same pattern
  layout, so the log output format stays unchanged.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-4r [%t] %-5level %logger{36} %X - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.nsysmon" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>