<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle rules for n-sysmon.

  Calibrated to this codebase's established conventions (4-space indent, braces
  on the same line, long lines tolerated where a call chain cannot be wrapped)
  rather than to a generic third-party profile. The intent is to catch genuine
  defects - unused code, broken whitespace, missing braces, empty or duplicated
  logic - not to reformat code that is already consistent.
-->
<module name="Checker">

    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="NewlineAtEndOfFile"/>
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

    <!--
      The codebase has ~300 lines over 120 characters, mostly deeply nested call
      chains and long constructor calls that cannot be wrapped readably. The limit
      sits above the observed maximum (316) so the check only catches runaway lines.
    -->
    <module name="LineLength">
        <property name="max" value="320"/>
    </module>

    <module name="TreeWalker">

        <!-- ==================== imports ==================== -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport"/>

        <!-- ==================== naming ==================== -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <!-- test methods commonly use scenario_style names, so underscores are allowed -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>
        <!-- "log" is the conventional name for the private static logger field -->
        <module name="ConstantName">
            <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>

        <!-- ==================== blocks and braces ==================== -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <!--
          "} else {", "} catch {" and "} finally {" all on one line, i.e. the conventional Java
          style. The codebase was mixed here (else on the next line, finally on the same one);
          it is normalised to this single style.
        -->
        <module name="RightCurly">
            <property name="option" value="same"/>
        </module>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="EmptyStatement"/>
        <module name="AvoidNestedBlocks"/>

        <!-- ==================== whitespace ==================== -->
        <!--
          The project's house style is "if(x) {" - no space between a control-flow
          keyword and its parenthesis - so the keyword tokens are deliberately excluded
          from the two checks below. Only genuinely missing whitespace is reported.
        -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA,SEMI"/>
        </module>
        <module name="WhitespaceAround">
            <property name="tokens" value="ASSIGN,BAND,BAND_ASSIGN,BOR,BOR_ASSIGN,BSR,BSR_ASSIGN,BXOR,BXOR_ASSIGN,COLON,DIV,DIV_ASSIGN,EQUAL,GE,GT,LAND,LCURLY,LE,LOR,LT,MINUS,MINUS_ASSIGN,MOD,MOD_ASSIGN,NOT_EQUAL,PLUS,PLUS_ASSIGN,QUESTION,RCURLY,SL,SL_ASSIGN,SLIST,SR,SR_ASSIGN,STAR,STAR_ASSIGN,LITERAL_ASSERT,TYPE_EXTENSION_AND"/>
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
        </module>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
        <module name="NoWhitespaceBefore"/>
        <module name="TypecastParenPad"/>

        <!-- ==================== modifiers and redundancy ==================== -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="FinalClass"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="InterfaceIsType"/>
        <module name="OneTopLevelClass"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>

        <!-- ==================== correctness ==================== -->
        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="DefaultComesLast"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <!--
          IllegalCatch is intentionally not enabled: catching Exception is this codebase's
          deliberate defensive pattern in the measurers, data sinks and offloading code, where a
          monitoring failure must never propagate into the monitored application.
        -->
        <module name="NoFinalizer"/>
        <module name="IllegalThrows"/>

        <!-- ==================== size ==================== -->
        <module name="MethodLength">
            <property name="max" value="80"/>
        </module>
        <module name="OuterTypeFilename"/>

    </module>

    <module name="FileLength">
        <property name="max" value="1500"/>
    </module>

</module>